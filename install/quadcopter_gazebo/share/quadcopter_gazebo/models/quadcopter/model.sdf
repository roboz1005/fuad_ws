<?xml version="1.0"?>
<sdf version="1.10">
  <model name="X3">
    <static>false</static>
    <pose>0 0 0.5 0 0 0</pose>

    <link name="base_link">
      <inertial>
        <mass>1.5</mass>
        <inertia>
          <ixx>0.0348</ixx>
          <iyy>0.0348</iyy>
          <izz>0.0667</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry>
          <box><size>0.4 0.4 0.1</size></box>
        </geometry>
      </collision>
      <visual name="base_visual">
        <geometry>
          <box><size>0.4 0.4 0.1</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.6 0.9 1</ambient>
          <diffuse>0.2 0.6 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Rotors -->
    <link name="rotor_0">
      <pose>0.2 -0.2 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <collision name="rotor_0_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="rotor_0_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rotor_1">
      <pose>-0.2 -0.2 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <collision name="rotor_1_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="rotor_1_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rotor_2">
      <pose>-0.2 0.2 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <collision name="rotor_2_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="rotor_2_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="rotor_3">
      <pose>0.2 0.2 0.05 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-5</ixx>
          <iyy>1e-5</iyy>
          <izz>1e-5</izz>
        </inertia>
      </inertial>
      <collision name="rotor_3_collision">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
      </collision>
      <visual name="rotor_3_visual">
        <geometry><cylinder><radius>0.1</radius><length>0.02</length></cylinder></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- FIX: Camera sensor moved from base_link to camera_link -->
    <link name="camera_link">
      <pose>0.2 0 0 0 0.785 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <iyy>1e-6</iyy>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <collision name="camera_collision">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
      </collision>
      <visual name="camera_visual">
        <geometry><box><size>0.02 0.02 0.02</size></box></geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
      <!-- Camera sensor now lives on camera_link so the bridge topic matches -->
      <sensor name="camera" type="camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
    </link>

    <!-- Joints -->
    <joint name="rotor_0_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_0</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.000</damping>
          <friction>0.000</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_1_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.000</damping>
          <friction>0.000</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_2_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.000</damping>
          <friction>0.000</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="rotor_3_joint" type="revolute">
      <parent>base_link</parent>
      <child>rotor_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.000</damping>
          <friction>0.000</friction>
        </dynamics>
      </axis>
    </joint>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Gazebo Harmonic Plugins -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odometry_frame>world</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>

    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>X3</robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <jointName>rotor_1_joint</jointName>
      <jointName>rotor_2_joint</jointName>
      <jointName>rotor_3_joint</jointName>
      <linkName>base_link</linkName>
      <motorConstant>8.54858e-06</motorConstant>
      <momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic>
      <maxRotVelocity>1000</maxRotVelocity>
    </plugin>

    <!-- FIX: Battery plugin name changed to Harmonic-compatible LinearBatteryPlugin -->
    <plugin filename="gz-sim-linearbatteryplugin-system"
            name="gz::sim::systems::LinearBatteryPlugin">
      <battery_name>quadcopter_battery</battery_name>
      <voltage>12.6</voltage>
      <capacity>5.0</capacity>
      <resistance>0.01</resistance>
      <power_load>2.0</power_load>
      <start_on_motion>true</start_on_motion>
    </plugin>

  </model>
</sdf>