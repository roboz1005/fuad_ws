<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- 
  FILE LOCATION: fuad_ws/src/integration_pkg/package.xml
  This is the ROS 2 package manifest. It tells colcon/build tools what this 
  package needs (dependencies) and what it provides. 
-->
<package format="3">
  <name>integration_pkg</name>
  <version>0.0.1</version>
  <description>Integration package for TurtleBot3 + Quadcopter in Gazebo Harmonic</description>
  <maintainer email="fuad@example.com">Fuad</maintainer>
  <license>MIT</license>

  <!-- Build dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>

  <!-- For PyQt dashboard -->
  <depend>python3-qt5-bindings</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
